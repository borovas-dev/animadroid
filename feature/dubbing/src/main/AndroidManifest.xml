<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Package visibility (API 30+): needed to detect TTS engines and resolve the voice-data installer. -->
    <queries>
        <intent><action android:name="android.intent.action.TTS_SERVICE" /></intent>
        <intent><action android:name="android.speech.tts.engine.INSTALL_TTS_DATA" /></intent>
    </queries>
</manifest>
